# Projeto do Supabase (Settings → API). A publishable key (ou a anon key legada) é pública:
# quem protege os dados é o RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Endereço público do site (https://...), só no servidor: base do sitemap e da prévia do link
# (Open Graph) que o WhatsApp e o Instagram mostram.
APP_URL=http://localhost:3000
